{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "17c619232f5d84567cd69896e892f326",
  "name": "rundown-query",
  "main": "index.ts",
  "compatibility_date": "2026-08-29",
  "limits": {
    "cpu_ms": 300000,
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "17c619232f5d84567cd69896e892f326",
  },
  "secrets": {
    "required": ["R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "workers_dev": false,
  "env": {
    "preview": {
      "name": "rundown-query-preview",
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "17c619232f5d84567cd69896e892f326",
      },
      "secrets": {
        "required": ["R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"],
      },
    },
  },
}
